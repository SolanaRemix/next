{
  "name": "@next/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -b",
    "start": "node dist/main.js",
    "start:dev": "prisma generate && tsx watch src/main.ts",
    "bootstrap:admin": "node --env-file=.env --import tsx scripts/bootstrap-admin.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.12.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.19.4",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/passport-jwt": "4.0.1",
    "prisma": "6.12.0",
    "tsx": "4.21.0"
  }
}
