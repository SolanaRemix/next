# API settings; use the root .env.example for frontend and docker-compose settings.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mega-gods-prompt-next-api
DATABASE_URL=postgresql://localhost:5432/next?schema=public
JWT_ACCESS_SECRET=
REDIS_URL=redis://localhost:6379
# Compose-only database and Redis credentials; use URL-safe random values for passwords.
POSTGRES_DB=next
POSTGRES_USER=next
POSTGRES_PASSWORD=
REDIS_PASSWORD=
GEO_BLOCKED_COUNTRIES=
GEO_TRUSTED_PROXY_CIDRS=
# Production requires an exact comma-separated allowlist of private RPC hostnames.
RPC_PRIVATE_HOSTS=
JUPITER_API_KEY=
COINGECKO_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ZEROX_API_KEY=
ONEINCH_API_KEY=
EVM_RPC_URL_1=
EVM_RPC_URL_10=
EVM_RPC_URL_56=
EVM_RPC_URL_137=
EVM_RPC_URL_8453=
EVM_RPC_URL_42161=
EVM_RPC_URL_43114=
EVM_CONFIRMATIONS_1=12
EVM_CONFIRMATIONS_10=20
EVM_CONFIRMATIONS_56=15
EVM_CONFIRMATIONS_137=128
EVM_CONFIRMATIONS_8453=20
EVM_CONFIRMATIONS_42161=20
EVM_CONFIRMATIONS_43114=12
