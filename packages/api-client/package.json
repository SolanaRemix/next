{
  "name": "@next/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-zod-client ../../openapi/openapi.yaml --output src/generated.ts --with-alias --export-schemas --default-status auto-correct",
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@zodios/core": "10.9.6",
    "axios": "1.20.0",
    "zod": "3.25.76"
  }
}
