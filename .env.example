# Frontend settings
VITE_API_URL=http://localhost:3001/api
VITE_SOLANA_RPC_URL=

# API runtime settings (used by docker compose or apps/api/.env)
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:8080
DATABASE_URL=postgresql://localhost:5432/next?schema=public
JWT_ACCESS_SECRET=
REDIS_URL=redis://localhost:6379
POSTGRES_DB=next
POSTGRES_USER=next
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Production must use approved private RPC hosts; RPC_PRIVATE_HOSTS is a
# comma-separated exact-host allowlist, for example solana.rpc.example,eth.rpc.example.
RPC_PRIVATE_HOSTS=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
EVM_RPC_URL_1=
EVM_RPC_URL_10=
EVM_RPC_URL_56=
EVM_RPC_URL_137=
EVM_RPC_URL_8453=
EVM_RPC_URL_42161=
EVM_RPC_URL_43114=

# Optional server-side aggregator credentials; never expose these as VITE_ variables.
JUPITER_API_KEY=
ZEROX_API_KEY=
ONEINCH_API_KEY=

# Optional EVM confirmation-depth overrides (minimum 2)
EVM_CONFIRMATIONS_1=12
EVM_CONFIRMATIONS_10=20
EVM_CONFIRMATIONS_56=15
EVM_CONFIRMATIONS_137=128
EVM_CONFIRMATIONS_8453=20
EVM_CONFIRMATIONS_42161=20
EVM_CONFIRMATIONS_43114=12
